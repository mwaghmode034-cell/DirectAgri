# Copy to .env locally. Never commit real credentials.
MONGODB_URI=
MONGODB_DB=directagri
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Optional Gemini listing extraction. Keep this key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Leave blank to use Google's default endpoint for the selected model.
GEMINI_API_URL=
# Set to "gemini" to disable the local rule-based parser while testing Gemini.
NLP_PROVIDER=

# Optional SMTP password-reset delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
